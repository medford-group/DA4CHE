axes.prop_cycle : cycler('color', ['003057', 'EAAA00', '4B8B9B', 'B3A369', '377117', '1879DB', '8E8B76', 'F5D580', '002233'])
axes.titlesize : 15
axes.titleweight : ultralight
axes.labelsize : 12
axes.labelweight : ultralight

xtick.labelsize : 10
xtick.direction : in

ytick.labelsize : 10
ytick.left : True
ytick.direction : in

lines.linewidth : 2
lines.linestyle : -

figure.titlesize : 18
figure.titleweight : bold
figure.figsize : 8, 6
figure.dpi : 150
figure.autolayout : True

savefig.dpi : 300
savefig.format : pdf
savefig.transparent : True

font.size : 18
font.family : sans-serif
font.sans-serif : Helvetica
font.style : normal

mathtext.default : regular

legend.fontsize : 10
