Google Analtyics -->\n<script async=\"async\" src=\"https://www.googletagmanager.com/gtag/js?id=G-PS24JGCKSZ\"></script>\n<script>\n  window.dataLayer = window.dataLayer || [];\n  function gtag(){dataLayer.push(arguments);}\n  gtag('js', new Date());\n  gtag('config', 'G-PS24JGCKSZ',\n       {'cookie_domain': 'webbook.nist.gov',\n        'cookie_flags': 'SameSite=None;Secure'});\n</script>\n<!-- End of NIST Google Analytics -->\n\n\n\n\n\n\n\n\n\n<script type=\"text/javascript\"\n        src=\"/packages/jquery/jquery-3.5.1.min.js\"></script>\n\n\n\n\n\n<script type=\"text/javascript\"\n        src=\"/packages/menu/menu.js\"></script>\n\n\n\n\n<script type=\"text/javascript\"\n src=\"/packages/nist/nist-exit-script.js\"></script>\n\n<script type=\"text/javascript\"\n src=\"/packages/local/copy-button.js\"></script>\n\n<!-- svg4everybody.js by Jon Neal enables external SVG on older\n     browsers. See https://github.com/jonathantneal/svg4everybody\n     for more information. -->\n<script src=\"/packages/svg4everybody/svg4everybody.js\"></script>\n<script>svg4everybody();</script>\n\n<!-- Script for inserting US government banner. -->\n<script src=\"/packages/uswds/components/usa-banner.js.mjs\"\n        type=\"module\"></script>\n\n\n</head>\n<body>\n<p id=\"skip-link\"><a class=\"element-invisible element-focusable\" href=\"#main\">\nJump to content</a>\n</p>\n<usa-banner></usa-banner>\n<header>\n<div class=\"webbook_header_bar\"  role=\"presentation\"\n  aria-label=\"Site label for NIST Chemistry WebBook\">\n<span class=\"logo\">\n  <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://www.nist.gov/\"\n     title=\"Link to NIST home page\">National Institute of Standards and\n    Technology</a>\n</span>\n<h1><span class=\"no-handheld\">NIST</span> Chemistry\n  WebBook<span class=\"no-handheld\">, SRD 69</span></h1>\n</div>\n\n<div class=\"no-print\" role=\"navigation\" aria-label=\"Main menu\">\n  <ul class=\"webbook_nav\">\n    <li>\n      <a href=\"/chemistry/\"\n         title=\"Main page of this site\">\n        <span class=\"sr-only\">Home</span>\n        <svg xmlns=\"http://www.w3.org/2000/svg\"\n             xmlns:xlink=\"http://www.w3.org/1999/xlink\"\n             class=\"webbook_icon_big\" role=\"img\"\n             aria-label=\"Home\" aria-hidden=\"true\">\n          <use xlink:href=\"/chemistry//img/icons.svg#home-icon\"></use>\n      </svg></a>\n    </li>\n    <li>\n      <a class=\"menu_below\" href=\"#\">Search</a>\n      <ul>\n        <li>\n          <a href=\"/chemistry/name-ser/\"\n             title=\"Search for species by chemical name\">\n            Name</a>\n        </li>\n        <li>\n          <a href=\"/chemistry/form-ser/\"\n             title=\"Search for species by chemical formula\">\n            Formula</a>\n        </li>\n        <li>\n          <a href=\"/chemistry/inchi-ser/\"\n             title=\"Search for species by InChI or InChIKey\">\n            IUPAC identifier</a>\n        </li>\n        <li>\n          <a href=\"/chemistry/cas-ser/\"\n             title=\"Search for species by CAS number\">\n            CAS number</a>\n        </li>\n        <li>\n          <a href=\"/chemistry/#Search\"\n             title=\"More serach options on the main page of this site\">\n            More options</a>\n        </li>\n      </ul>\n    </li>\n    <li class=\"no-handheld\">\n      <a class=\"menu_below\" href=\"#\">NIST Data</a>\n      <ul>\n        <li>\n          <a href=\"https://www.nist.gov/srd/\"\n             title=\"Standard Reference Data page\">SRD Program\n          </a>\n        </li>\n        <li>\n          <a href=\"https://data.nist.gov/sdp/\"\n             title=\"NIST data discovery site\">Science Data Portal\n          </a>\n        </li>\n        <li>\n          <a href=\"https://www.nist.gov/mml/mdd\"\n             title=\"Material Data Division page\">Material Data\n            Division\n          </a>\n        </li>\n      </ul>\n    </li>\n    <li>\n      <a class=\"menu_below\" href=\"#\">About</a>\n      <ul>\n        <li>\n          <a href=\"/chemistry/faq/\"\n             title=\"Frequently asked questions page\">\n          FAQ</a>\n        </li>\n        <li>\n          <a href=\"/chemistry/#CreditsControl\"\n             title=\"Credits on the main page of the site\">\n            Credits</a>\n        </li>\n        <li>\n          <a href=\"/chemistry/#Documentation\"\n             title=\"More documentation on the main page of the site\">\n            More documentation</a>\n        </li>\n      </ul>\n    </li>\n  </ul>\n</div>\n\n</header>\n\n<main id=\"main\">\n\n\n\n\n<h1 id=\"Top\">Methane</h1>\n\n<ul>\n\n<li><strong><a\n title=\"IUPAC definition of empirical formula\"\n href=\"http://goldbook.iupac.org/E02063.html\">Formula</a>:</strong> CH<sub>4</sub></li>\n\n\n<li><strong><a\n title=\"IUPAC definition of relative molecular mass (molecular weight)\"\n href=\"http://goldbook.iupac.org/R05271.html\">Molecular weight</a>:</strong> 16.0425</li>\n\n\n<li><div class=\"row-flex\">\n<div class=\"left-float\">\n<strong>IUPAC Standard InChI:</strong>\n<span class=\"inchi-text\">InChI=1S/CH4/h1H4</span>\n<button class=\"copy-prior-text plain-button\">\n  <span class=\"sr-only\">Copy</span>\n  <svg xmlns=\"http://www.w3.org/2000/svg\"\n       xmlns:xlink=\"http://www.w3.org/1999/xlink\"\n       class=\"webbook_icon_copy\" role=\"img\"\n       aria-label=\"Copy\" aria-hidden=\"true\">\n    <use xlink:href=\"/chemistry//img/icons.svg#clip-copy-icon\"></use>\n</svg>\n</button>\n</div>\n<div class=\"left-float inchi-trust\">\n<a href=\"http://www.inchi-trust.org\"\n title=\"InChI Trust web site (outside of NIST)\">\n<img class=\"inchi-trust\"\n src=\"/chemistry/img/inchi_v106.png\"\n alt=\"InChI version 1.06\" /></a></div></div>\n</li>\n\n\n<li>\n<strong>IUPAC Standard InChIKey:</strong>\n<span class=\"inchi-text\">VNWKTOKETHGBQD-UHFFFAOYSA-N</span>\n<button class=\"copy-prior-text plain-button\">\n  <span class=\"sr-only\">Copy</span>\n  <svg xmlns=\"http://www.w3.org/2000/svg\"\n       xmlns:xlink=\"http://www.w3.org/1999/xlink\"\n       class=\"webbook_icon_copy\" role=\"img\"\n       aria-label=\"Copy\" aria-hidden=\"true\">\n    <use xlink:href=\"/chemistry//img/icons.svg#clip-copy-icon\"></use>\n</svg>\n</button>\n</li>\n\n\n<li><strong>CAS Registry Number:</strong> 74-82-8</li>\n\n\n\n<li><strong>Chemical structure:</strong> <img src=\"/cgi/cbook.cgi?Struct=C74828&amp;Type=Color\"\n class=\"struct\" alt=\"CH4\" />\n\n<br />\nThis structure is also available as a <a href=\"/cgi/cbook.cgi?Str2File=C74828\">2d Mol file</a>\n\n\nor as a <a href=\"/chemistry/3d-structs/\">computed</a>\n<a href=\"/cgi/cbook.cgi?Str3File=C74828\">3d SD file</a>\n<br />\n<a href=\"/cgi/cbook.cgi?Str3View=C74828&amp;Type=JSmol\">View\n3d structure</a> (requires JavaScript / HTML 5)\n\n\n</li>\n\n\n\n\n\n\n<li><strong>Other names:</strong>\nMarsh gas;\nMethyl hydride;\nCH4;\nFire Damp;\nR 50;\nBiogas;\nR 50 (refrigerant)\n</li>\n\n\n<li>\n<strong><a href=\"/cgi/inchi/InChI%3D1S/CH4/h1H4\">Permanent link</a>\n</strong> for this species. Use this link for bookmarking this species\nfor future reference.\n</li>\n\n\n\n<li><strong>Information on this page:</strong>\n<ul>\n<li><a href=\"#Notes\">Notes</a></li>\n\n</ul></li>\n\n\n<li><strong>Other data available:</strong>\n<ul>\n<li><a href=\"/cgi/cbook.cgi?ID=C74828&amp;Units=SI&amp;Mask=1#Thermo-Gas\">Gas phase thermochemistry data</a></li>\n<li><a href=\"/cgi/cbook.cgi?ID=C74828&amp;Units=SI&amp;Mask=4#Thermo-Phase\">Phase change data</a></li>\n<li>Reaction thermochemistry data:\n<a href=\"/cgi/cbook.cgi?ID=C74828&amp;Units=SI&amp;Mask=8#Thermo-React\">reactions 1 to 50</a>,\n<a href=\"/cgi/cbook.cgi?ID=C74828&amp;Units=SI&amp;Mask=8&amp;StartReac=50#Thermo-React\">reactions 51 to 100</a>,\n<a href=\"/cgi/cbook.cgi?ID=C74828&amp;Units=SI&amp;Mask=8&amp;StartReac=100#Thermo-React\">reactions 101 to 112</a></li>\n<li><a href=\"/cgi/cbook.cgi?ID=C74828&amp;Units=SI&amp;Mask=10#Solubility\">Henry's Law data</a></li>\n<li><a href=\"/cgi/cbook.cgi?ID=C74828&amp;Units=SI&amp;Mask=20#Ion-Energetics\">Gas phase ion energetics data</a></li>\n<li><a href=\"/cgi/cbook.cgi?ID=C74828&amp;Units=SI&amp;Mask=40#Ion-Cluster\">Ion clustering data</a></li>\n<li><a href=\"/cgi/cbook.cgi?ID=C74828&amp;Units=SI&amp;Mask=80#IR-Spec\">IR Spectrum</a></li>\n<li><a href=\"/cgi/cbook.cgi?ID=C74828&amp;Units=SI&amp;Mask=200#Mass-Spec\">Mass spectrum (electron ionization)</a></li>\n<li><a href=\"/cgi/cbook.cgi?ID=C74828&amp;Units=SI&amp;Mask=800#Electronic-Spec\">Vibrational and/or electronic energy levels</a></li>\n<li><a href=\"/cgi/fluid.cgi?ID=C74828&amp;Action=Page\">Fluid Properties</a></li>\n\n</ul></li>\n\n\n<li><strong>Data at other public NIST sites:</strong>\n<ul>\n<li><a href=\"https://physics.nist.gov/cgi-bin/MolSpec/mole.pl?prefix=hydro&amp;molecule=CH4&amp;cas=74-82-8&amp;type=fancy&amp;clear=1\">Microwave spectra (on physics lab web site)</a></li>\n<li><a href=\"https://physics.nist.gov/cgi-bin/Ionization/table.pl?ionization=CH4\">Electron-Impact Ionization Cross Sections (on physics web site)</a></li>\n<li><a href=\"https://kinetics.nist.gov/kinetics/rpSearch?cas=74828\">Gas Phase Kinetics Database</a></li>\n\n</ul></li>\n\n\n\n<li><strong>Options:</strong>\n<ul>\n\n<li><a href=\"/cgi/cbook.cgi?ID=C74828&amp;Units=CAL\">Switch to calorie-based units</a></li>\n\n</ul></li>\n\n</ul>\n\n\n<h2>Data at NIST subscription sites:</h2>\n<ul>\n<li><a href=\"https://wtt-lite.nist.gov/wtt-lite/index.html?cmp=methane\">NIST / TRC Web Thermo Tables, &quot;lite&quot; edition (thermophysical and thermochemical data)</a></li>\n<li><a href=\"https://wtt-pro.nist.gov/wtt-pro/index.html?cmp=methane\">NIST / TRC Web Thermo Tables, professional edition (thermophysical and thermochemical data)</a></li>\n\n</ul>\n\n\n<p>\nNIST subscription sites provide data under the\n<a href=\"https://www.nist.gov/srd/\" title=\"Link to NIST\nStandard Reference Data web site\">NIST Standard Reference\nData Program</a>, but require an annual fee to access.\nThe purpose of the fee is to recover costs associated\nwith the development of data collections included in\nsuch sites. Your institution may already be a subscriber.\nFollow the links above to find out more about the data\nin these sites and their terms of usage.\n</p>\n\n\n\n<hr />\n\n<h2 id=\"Notes\">Notes</h2>\n<p class=\"section-head\"><strong>Go To:</strong> <a href=\"#Top\">Top</a></p>\n\n<ul>\n\n<li>Data from NIST Standard Reference Database 69:\n<em>NIST Chemistry WebBook</em></li>\n<li>\nThe National Institute of Standards and Technology (NIST)\nuses its best efforts to deliver a high quality copy of the\nDatabase and to verify that the data contained therein have\nbeen selected on the basis of sound scientific judgment.\nHowever, NIST makes no warranties to that effect, and NIST\nshall not be liable for any damage that may result from\nerrors or omissions in the Database.</li>\n<li>\n<a href=\"/cdn-cgi/l/email-protection#6e0a0f1a0f2e00071d1a40090118\" title=\"Link to the NIST SRD customer support email address.\">Customer support</a>\nfor NIST Standard Reference Data products.</li>\n</ul>\n\n\n\n<hr />\n<p id=\"copyright\" lang=\"en\">&copy; <em>2026 by the U.S. Secretary of Commerce\non behalf of the United States of America. All rights reserved.</em>\n</p>\n\n<p lang=\"en\">\nCopyright for NIST Standard Reference Data is governed by\nthe <a href=\"https://www.nist.gov/srd/public-law\"\n title=\"Link to page with information on the Standard Reference Data Act\">\nStandard Reference Data Act</a>.\n</p>\n\n\n\n</main>\n\n<footer id=\"footer\">\n\n<div class=\"row\">\n  <ul class=\"list-center-inline\">\n    <li><a href=\"https://www.nist.gov/privacy-policy\"\n           title=\"NIST site privacy statement\"\n           target=\"_blank\" rel=\"noopener noreferrer\">Site Privacy</a>\n    </li>\n    <li><a href=\"https://www.nist.gov/oism/accessibility\"\n           tit