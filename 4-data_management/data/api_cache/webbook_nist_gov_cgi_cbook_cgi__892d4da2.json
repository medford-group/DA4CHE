Google Analtyics -->\n<script async=\"async\" src=\"https://www.googletagmanager.com/gtag/js?id=G-PS24JGCKSZ\"></script>\n<script>\n  window.dataLayer = window.dataLayer || [];\n  function gtag(){dataLayer.push(arguments);}\n  gtag('js', new Date());\n  gtag('config', 'G-PS24JGCKSZ',\n       {'cookie_domain': 'webbook.nist.gov',\n        'cookie_flags': 'SameSite=None;Secure'});\n</script>\n<!-- End of NIST Google Analytics -->\n\n\n\n\n\n\n\n\n\n<script type=\"text/javascript\"\n        src=\"/packages/jquery/jquery-3.5.1.min.js\"></script>\n\n\n\n\n\n<script type=\"text/javascript\"\n        src=\"/packages/menu/menu.js\"></script>\n\n\n\n\n<script type=\"text/javascript\"\n src=\"/packages/nist/nist-exit-script.js\"></script>\n\n<script type=\"text/javascript\"\n src=\"/packages/local/copy-button.js\"></script>\n\n<!-- svg4everybody.js by Jon Neal enables external SVG on older\n     browsers. See https://github.com/jonathantneal/svg4everybody\n     for more information. -->\n<script src=\"/packages/svg4everybody/svg4everybody.js\"></script>\n<script>svg4everybody();</script>\n\n<!-- Script for inserting US government banner. -->\n<script src=\"/packages/uswds/components/usa-banner.js.mjs\"\n        type=\"module\"></script>\n\n\n</head>\n<body>\n<p id=\"skip-link\"><a class=\"element-invisible element-focusable\" href=\"#main\">\nJump to content</a>\n</p>\n<usa-banner></usa-banner>\n<header>\n<div class=\"webbook_header_bar\"  role=\"presentation\"\n  aria-label=\"Site label for NIST Chemistry WebBook\">\n<span class=\"logo\">\n  <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://www.nist.gov/\"\n     title=\"Link to NIST home page\">National Institute of Standards and\n    Technology</a>\n</span>\n<h1><span class=\"no-handheld\">NIST</span> Chemistry\n  WebBook<span class=\"no-handheld\">, SRD 69</span></h1>\n</div>\n\n<div class=\"no-print\" role=\"navigation\" aria-label=\"Main menu\">\n  <ul class=\"webbook_nav\">\n    <li>\n      <a href=\"/chemistry/\"\n         title=\"Main page of this site\">\n        <span class=\"sr-only\">Home</span>\n        <svg xmlns=\"http://www.w3.org/2000/svg\"\n             xmlns:xlink=\"http://www.w3.org/1999/xlink\"\n             class=\"webbook_icon_big\" role=\"img\"\n             aria-label=\"Home\" aria-hidden=\"true\">\n          <use xlink:href=\"/chemistry//img/icons.svg#home-icon\"></use>\n      </svg></a>\n    </li>\n    <li>\n      <a class=\"menu_below\" href=\"#\">Search</a>\n      <ul>\n        <li>\n          <a href=\"/chemistry/name-ser/\"\n             title=\"Search for species by chemical name\">\n            Name</a>\n        </li>\n        <li>\n          <a href=\"/chemistry/form-ser/\"\n             title=\"Search for species by chemical formula\">\n            Formula</a>\n        </li>\n        <li>\n          <a href=\"/chemistry/inchi-ser/\"\n             title=\"Search for species by InChI or InChIKey\">\n            IUPAC identifier</a>\n        </li>\n        <li>\n          <a href=\"/chemistry/cas-ser/\"\n             title=\"Search for species by CAS number\">\n            CAS number</a>\n        </li>\n        <li>\n          <a href=\"/chemistry/#Search\"\n             title=\"More serach options on the main page of this site\">\n            More options</a>\n        </li>\n      </ul>\n    </li>\n    <li class=\"no-handheld\">\n      <a class=\"menu_below\" href=\"#\">NIST Data</a>\n      <ul>\n        <li>\n          <a href=\"https://www.nist.gov/srd/\"\n             title=\"Standard Reference Data page\">SRD Program\n          </a>\n        </li>\n        <li>\n          <a href=\"https://data.nist.gov/sdp/\"\n             title=\"NIST data discovery site\">Science Data Portal\n          </a>\n        </li>\n        <li>\n          <a href=\"https://www.nist.gov/mml/mdd\"\n             title=\"Material Data Division page\">Material Data\n            Division\n          </a>\n        </li>\n      </ul>\n    </li>\n    <li>\n      <a class=\"menu_below\" href=\"#\">About</a>\n      <ul>\n        <li>\n          <a href=\"/chemistry/faq/\"\n             title=\"Frequently asked questions page\">\n          FAQ</a>\n        </li>\n        <li>\n          <a href=\"/chemistry/#CreditsControl\"\n             title=\"Credits on the main page of the site\">\n            Credits</a>\n        </li>\n        <li>\n          <a href=\"/chemistry/#Documentation\"\n             title=\"More documentation on the main page of the site\">\n            More documentation</a>\n        </li>\n      </ul>\n    </li>\n  </ul>\n</div>\n\n</header>\n\n<main id=\"main\">\n\n\n\n\n<h1 id=\"Top\">Methane</h1>\n\n<ul>\n\n<li><strong><a\n title=\"IUPAC definition of empirical formula\"\n href=\"http://goldbook.iupac.org/E02063.html\">Formula</a>:</strong> CH<sub>4</sub></li>\n\n\n<li><strong><a\n title=\"IUPAC definition of relative molecular mass (molecular weight)\"\n href=\"http://goldbook.iupac.org/R05271.html\">Molecular weight</a>:</strong> 16.0425</li>\n\n\n<li><div class=\"row-flex\">\n<div class=\"left-float\">\n<strong>IUPAC Standard InChI:</strong>\n<span class=\"inchi-text\">InChI=1S/CH4/h1H4</span>\n<button class=\"copy-prior-text plain-button\">\n  <span class=\"sr-only\">Copy</span>\n  <svg xmlns=\"http://www.w3.org/2000/svg\"\n       xmlns:xlink=\"http://www.w3.org/1999/xlink\"\n       class=\"webbook_icon_copy\" role=\"img\"\n       aria-label=\"Copy\" aria-hidden=\"true\">\n    <use xlink:href=\"/chemistry//img/icons.svg#clip-copy-icon\"></use>\n</svg>\n</button>\n</div>\n<div class=\"left-float inchi-trust\">\n<a href=\"http://www.inchi-trust.org\"\n title=\"InChI Trust web site (outside of NIST)\">\n<img class=\"inchi-trust\"\n src=\"/chemistry/img/inchi_v106.png\"\n alt=\"InChI version 1.06\" /></a></div></div>\n</li>\n\n\n<li>\n<strong>IUPAC Standard InChIKey:</strong>\n<span class=\"inchi-text\">VNWKTOKETHGBQD-UHFFFAOYSA-N</span>\n<button class=\"copy-prior-text plain-button\">\n  <span class=\"sr-only\">Copy</span>\n  <svg xmlns=\"http://www.w3.org/2000/svg\"\n       xmlns:xlink=\"http://www.w3.org/1999/xlink\"\n       class=\"webbook_icon_copy\" role=\"img\"\n       aria-label=\"Copy\" aria-hidden=\"true\">\n    <use xlink:href=\"/chemistry//img/icons.svg#clip-copy-icon\"></use>\n</svg>\n</button>\n</li>\n\n\n<li><strong>CAS Registry Number:</strong> 74-82-8</li>\n\n\n\n<li><strong>Chemical structure:</strong> <img src=\"/cgi/cbook.cgi?Struct=C74828&amp;Type=Color\"\n class=\"struct\" alt=\"CH4\" />\n\n<br />\nThis structure is also available as a <a href=\"/cgi/cbook.cgi?Str2File=C74828\">2d Mol file</a>\n\n\nor as a <a href=\"/chemistry/3d-structs/\">computed</a>\n<a href=\"/cgi/cbook.cgi?Str3File=C74828\">3d SD file</a>\n<br />\n<a href=\"/cgi/cbook.cgi?Str3View=C74828&amp;Type=JSmol\">View\n3d structure</a> (requires JavaScript / HTML 5)\n\n\n</li>\n\n\n\n\n\n\n<li><strong>Other names:</strong>\nMarsh gas;\nMethyl hydride;\nCH4;\nFire Damp;\nR 50;\nBiogas;\nR 50 (refrigerant)\n</li>\n\n\n<li>\n<strong><a href=\"/cgi/inchi/InChI%3D1S/CH4/h1H4\">Permanent link</a>\n</strong> for this species. Use this link for bookmarking this species\nfor future reference.\n</li>\n\n\n\n<li><strong>Information on this page:</strong>\n<ul>\n<li><a href=\"#Thermo-Gas\">Gas phase thermochemistry data</a></li>\n<li><a href=\"#Refs\">References</a></li>\n<li><a href=\"#Notes\">Notes</a></li>\n\n</ul></li>\n\n\n<li><strong>Other data available:</strong>\n<ul>\n<li><a href=\"/cgi/cbook.cgi?ID=C74828&amp;Units=SI&amp;Mask=4#Thermo-Phase\">Phase change data</a></li>\n<li>Reaction thermochemistry data:\n<a href=\"/cgi/cbook.cgi?ID=C74828&amp;Units=SI&amp;Mask=8#Thermo-React\">reactions 1 to 50</a>,\n<a href=\"/cgi/cbook.cgi?ID=C74828&amp;Units=SI&amp;Mask=8&amp;StartReac=50#Thermo-React\">reactions 51 to 100</a>,\n<a href=\"/cgi/cbook.cgi?ID=C74828&amp;Units=SI&amp;Mask=8&amp;StartReac=100#Thermo-React\">reactions 101 to 112</a></li>\n<li><a href=\"/cgi/cbook.cgi?ID=C74828&amp;Units=SI&amp;Mask=10#Solubility\">Henry's Law data</a></li>\n<li><a href=\"/cgi/cbook.cgi?ID=C74828&amp;Units=SI&amp;Mask=20#Ion-Energetics\">Gas phase ion energetics data</a></li>\n<li><a href=\"/cgi/cbook.cgi?ID=C74828&amp;Units=SI&amp;Mask=40#Ion-Cluster\">Ion clustering data</a></li>\n<li><a href=\"/cgi/cbook.cgi?ID=C74828&amp;Units=SI&amp;Mask=80#IR-Spec\">IR Spectrum</a></li>\n<li><a href=\"/cgi/cbook.cgi?ID=C74828&amp;Units=SI&amp;Mask=200#Mass-Spec\">Mass spectrum (electron ionization)</a></li>\n<li><a href=\"/cgi/cbook.cgi?ID=C74828&amp;Units=SI&amp;Mask=800#Electronic-Spec\">Vibrational and/or electronic energy levels</a></li>\n<li><a href=\"/cgi/fluid.cgi?ID=C74828&amp;Action=Page\">Fluid Properties</a></li>\n\n</ul></li>\n\n\n<li><strong>Data at other public NIST sites:</strong>\n<ul>\n<li><a href=\"https://physics.nist.gov/cgi-bin/MolSpec/mole.pl?prefix=hydro&amp;molecule=CH4&amp;cas=74-82-8&amp;type=fancy&amp;clear=1\">Microwave spectra (on physics lab web site)</a></li>\n<li><a href=\"https://physics.nist.gov/cgi-bin/Ionization/table.pl?ionization=CH4\">Electron-Impact Ionization Cross Sections (on physics web site)</a></li>\n<li><a href=\"https://kinetics.nist.gov/kinetics/rpSearch?cas=74828\">Gas Phase Kinetics Database</a></li>\n\n</ul></li>\n\n\n\n<li><strong>Options:</strong>\n<ul>\n\n<li><a href=\"/cgi/cbook.cgi?ID=C74828&amp;Units=CAL&amp;Mask=1\">Switch to calorie-based units</a></li>\n\n</ul></li>\n\n</ul>\n\n\n<h2>Data at NIST subscription sites:</h2>\n<ul>\n<li><a href=\"https://wtt-lite.nist.gov/wtt-lite/index.html?cmp=methane\">NIST / TRC Web Thermo Tables, &quot;lite&quot; edition (thermophysical and thermochemical data)</a></li>\n<li><a href=\"https://wtt-pro.nist.gov/wtt-pro/index.html?cmp=methane\">NIST / TRC Web Thermo Tables, professional edition (thermophysical and thermochemical data)</a></li>\n\n</ul>\n\n\n<p>\nNIST subscription sites provide data under the\n<a href=\"https://www.nist.gov/srd/\" title=\"Link to NIST\nStandard Reference Data web site\">NIST Standard Reference\nData Program</a>, but require an annual fee to access.\nThe purpose of the fee is to recover costs associated\nwith the development of data collections included in\nsuch sites. Your institution may already be a subscriber.\nFollow the links above to find out more about the data\nin these sites and their terms of usage.\n</p>\n\n\n\n<hr />\n\n<h2 id=\"Thermo-Gas\">Gas phase thermochemistry data</h2>\n<p class=\"section-head\"><strong>Go To:</strong> <a href=\"#Top\">Top</a>, <a href=\"#Refs\">References</a>, <a href=\"#Notes\">Notes</a></p>\n<p class=\"section-head\"><strong>\nData compilation <a href=\"#copyright\">copyright</a>\nby the U.S. Secretary of Commerce on behalf of the U.S.A.\nAll rights reserved.\n</strong></p>\n<p class=\"section-head\"><strong>Data compiled as indicated in comments:</strong><br />\n<em><a href=\"/cgi/cbook.cgi?Contrib=DRB\">DRB</a></em> - Donald R. Burgess, Jr.<br />\n<em><a href=\"/cgi/cbook.cgi?Contrib=ALS\">ALS</a></em> - Hussein Y. Afeefy, Joel F. Liebman, and Stephen E. Stein<br />\n<em><a href=\"/cgi/cbook.cgi?Contrib=GT\">GT</a></em> - Glushko Thermocenter, Russian Academy of Sciences, Moscow\n</p>\n<table class=\"data\" aria-label=\"One dimensional data\"><tr>\n<th scope=\"col\">Quantity</th>\n<th scope=\"col\">Value</th>\n<th scope=\"col\">Units</th>\n<th scope=\"col\">Method</th>\n<th scope=\"col\">Reference</th>\n<th scope=\"col\">Comment</th>\n</tr>\n<tr class=\"cal\"><td style=\"text-align: left;\">&#916;<sub>f</sub>H&deg;<sub>gas</sub></td><td class=\"right-nowrap\">-74.87</td><td style=\"text-align: right;\">kJ/mol</td><td style=\"text-align: center;\"><a href=\"/chemistry/enthalpy.html#Review\">Review</a></td><td style=\"text-align: left;\"><a href=\"#ref-1\">Chase, 1998</a></td><td style=\"text-align: left;\">Data last reviewed in March, 1961</td></tr>\n<tr class=\"exp\"><td style=\"text-align: left;\">&#916;<sub>f</sub>H&deg;<sub>gas</sub></td><td class=\"right-nowrap\">-74.6 &plusmn; 0.3</td><td style=\"text-align: right;\">kJ/mol</td><td style=\"text-align: center;\"><a href=\"/chemistry/enthalpy.html#Review\">Review</a></td><td style=\"text-align: left;\"><a href=\"#ref-2\">Manion, 2002</a></td><td style=\"text-align: left;\">adopted recommendation of  <a href=\"#ref-3\">Gurvich, Veyts, et al., 1991</a>; <em>DRB</em></td></tr>\n<tr class=\"exp\"><td style=\"text-align: left;\">&#916;<sub>f</sub>H&deg;<sub>gas</sub></td><td class=\"right-nowrap\">-74.5 &plusmn; 0.4</td><td style=\"text-align: right;\">kJ/mol</td><td style=\"text-align: center;\"><a href=\"/chemistry/enthalpy.html#Ccb\">Ccb</a></td><td style=\"text-align: left;\"><a href=\"#ref-4\">Pittam and Pilcher, 1972</a></td><td style=\"text-align: left;\"><em>ALS</em></td></tr>\n<tr class=\"exp\"><td style=\"text-align: left;\">&#916;<sub>f</sub>H&deg;<sub>gas</sub></td><td class=\"right-nowrap\">-74.85 &plusmn; 0.31</td><td style=\"text-align: right;\">kJ/mol</td><td style=\"text-align: center;\"><a href=\"/chemistry/enthalpy.html#Ccb\">Ccb</a></td><td style=\"text-align: left;\"><a href=\"#ref-5\">Prosen and Rossini, 1945</a></td><td style=\"text-align: left;\">Hf derived from Heat of Hydrogenation; <em>ALS</em></td></tr>\n<tr class=\"exp\"><td style=\"text-align: left;\">&#916;<sub>f</sub>H&deg;<sub>gas</sub></td><td class=\"right-nowrap\">-73.4 &plusmn; 1.1</td><td style=\"text-align: right;\">kJ/mol</td><td style=\"text-align: center;\"><a href=\"/chemistry/enthalpy.html#Ccb\">Ccb</a></td><td style=\"text-align: left;\"><a href=\"#ref-6\">Roth and Banse, 1932</a></td><td style=\"text-align: left;\">Reanalyzed by  <a href=\"#ref-7\">Cox and Pilcher, 1970</a>, Original value = -75.19 kJ/mol; <em>ALS</em></td></tr>\n<tr>\n<th scope=\"col\">Quantity</th>\n<th scope=\"col\">Value</th>\n<th scope=\"col\">Units</th>\n<th scope=\"col\">Method</th>\n<th scope=\"col\">Reference</th>\n<th scope=\"col\">Comment</th>\n</tr>\n<tr class=\"exp\"><td style=\"text-align: left;\">&#916;<sub>c</sub>H&deg;<sub>gas</sub></td><td class=\"right-nowrap\">-890.7 &plusmn; 0.4</td><td style=\"text-align: right;\">kJ/mol</td><td style=\"text-align: center;\"><a href=\"/chemistry/enthalpy.html#Ccb\">Ccb</a></td><td style=\"text-align: left;\"><a href=\"#ref-4\">Pittam and Pilcher, 1972</a></td><td style=\"text-align: left;\">Corresponding &#916;<sub>f</sub>H&ordm;<sub>gas</sub> = -74.48 kJ/mol (simple calculation by NIST; no Washburn corrections); <em>ALS</em></td></tr>\n<tr class=\"exp\"><td style=\"text-align: left;\">&#916;<sub>c</sub>H&deg;<sub>gas</sub></td><td class=\"right-nowrap\">-890.35 &plusmn; 0.30</td><td style=\"text-align: right;\">kJ/mol</td><td style=\"text-align: center;\"><a href=\"/chemistry/enthalpy.html#Ccb\">Ccb</a></td><td style=\"text-align: left;\"><a href=\"#ref-5\">Prosen and Rossini, 1945</a></td><td style=\"text-align: left;\">Hf derived from Heat of Hydrogenation; Corresponding &#916;<sub>f</sub>H&ordm;<sub>gas</sub> = -74.822 kJ/mol (simple calculation by NIST; no Washburn corrections); <em>ALS</em></td></tr>\n<tr class=\"exp\"><td style=\"text-align: left;\">&#916;<sub>c</sub>H&deg;<sub>gas</sub></td><td class=\"right-nowrap\">-891.8 &plusmn; 1.1</td><td style=\"text-align: right;\">kJ/mol</td><td style=\"text-align: center;\"><a href=\"/chemistry/enthalpy.html#Ccb\">Ccb</a></td><td style=\"text-align: left;\"><a href=\"#ref-6\">Roth and Banse, 1932</a></td><td style=\"text-align: left;\">Reanalyzed by  <a href=\"#ref-7\">Cox and Pilcher, 1970</a>, Original value = -887.3 &plusmn; 1.0  kJ/mol; Corresponding &#916;<sub>f</sub>H&ordm;<sub>gas</sub> = -73.39 kJ/mol (simple calculation by NIST; no Washburn corrections); <em>ALS</em></td></tr>\n<tr class=\"exp\"><td style=\"text-align: left;\">&#916;<sub>c</sub>H&deg;<sub>gas</sub></td><td class=\"right-nowrap\">-890.16 &plusmn; 0.30</td><td style=\"text-align: right;\">kJ/mol</td><td style=\"text-align: center;\"><a href=\"/chemistry/enthalpy.html#Cm\">Cm</a></td><td style=\"text-align: left;\"><a href=\"#ref-8\">Rossini, 1931</a></td><td style=\"text-align: left;\">Corresponding &#916;<sub>f</sub>H&ordm;<sub>gas</sub> = -75.010 kJ/mol (simple calculation by NIST; no Washburn corrections); <em>ALS</em></td></tr>\n<tr>\n<th scope=\"col\">Quantity</th>\n<th scope=\"col\">Value</th>\n<th scope=\"col\">Units</th>\n<th scope=\"col\">Method</th>\n<th scope=\"col\">Reference</th>\n<th scope=\"col\">Comment</th>\n</tr>\n<tr class=\"exp\"><td style=\"text-align: left;\">S&deg;<sub>gas</sub></td><td class=\"right-nowrap\">188.66 &plusmn; 0.42</td><td style=\"text-align: right;\">J/mol*K</td><td style=\"text-align: center;\">N/A</td><td style=\"text-align: left;\"><a href=\"#ref-9\">Colwell J.H., 1963</a></td><td style=\"text-align: left;\">The calorimetric value is significantly higher than the statistically calculated entropy, 186.26 J/mol*K, which remains the best value for use in thermodynamic calculations [ <a href=\"#ref-10\">Vogt G.J., 1976</a>,  <a href=\"#ref-11\">Friend D.G., 1989</a>,  <a href=\"#ref-12\">Gurvich, Veyts, et al., 1989</a>]. Earlier the value of 185.3 J/mol*K was calculated from experimental data [ <a href=\"#ref-13\">Giauque W.F., 1931</a>]. The value of S(298.15 K)=185.94 J/mol*K was obtained by high accuracy ab initio calculation [ <a href=\"#ref-14\">East A.L.L., 1997</a>].; <em>GT</em></td></tr>\n<tr>\n<th scope=\"col\">Quantity</th>\n<th scope=\"col\">Value</th>\n<th scope=\"col\">Units</th>\n<th scope=\"col\">Method</th>\n<th scope=\"col\">Reference</th>\n<th scope=\"col\">Comment</th>\n</tr>\n<tr class=\"cal\"><td style=\"text-align: left;\">S&deg;<sub>gas,1 bar</sub></td><td class=\"right-nowrap\">186.25</td><td style=\"text-align: right;\">J/mol*K</td><td style=\"text-align: center;\"><a href=\"/chemistry/enthalpy.html#Review\">Review</a></td><td style=\"text-align: left;\"><a href=\"#ref-1\">Chase, 1998</a></td><td style=\"text-align: left;\">Data last reviewed in March, 1961</td></tr>\n</table>\n\n<h3>Constant pressure heat capacity of gas</h3>\n<table class=\"data\" aria-label=\"Constant pressure heat capacity of gas\"><tr>\n<th scope=\"col\">C<sub>p,gas</sub> (J/mol*K)</th>\n<th scope=\"col\">Temperature (K)</th>\n<th scope=\"col\">Reference</th>\n<th scope=\"col\">Comment</th>\n</tr>\n<tr class=\"exp\"><td class=\"right-nowrap\">34.92 &plusmn; 0.25</td><td class=\"right-nowrap\">279.</td><td style=\"text-align: left;\"><a href=\"#ref-15\">Halford J.O., 1957</a></td><td style=\"text-align: left;\"><em>GT</em></td></tr>\n</table>\n\n<h3>Constant pressure heat capacity of gas</h3>\n<table class=\"data\" aria-label=\"Constant pressure heat capacity of gas\"><tr>\n<th scope=\"col\">C<sub>p,gas</sub> (J/mol*K)</th>\n<th scope=\"col\">Temperature (K)</th>\n<th scope=\"col\">Reference</th>\n<th scope=\"col\">Comment</th>\n</tr>\n<tr class=\"cal\"><td class=\"right-nowrap\">33.28</td><td class=\"right-nowrap\">100.</td><td rowspan=\"31\" style=\"text-align: left; vertical-align: top\"><a href=\"#ref-12\">Gurvich, Veyts, et al., 1989</a></td><td rowspan=\"31\" style=\"text-align: left; vertical-align: top\">p=1 bar. Because of more precise method of calculation, the recommended values are more accurate, especially at high temperatures, than those obtained by [ <a href=\"#ref-16\">McDowell R.S., 1963</a>] and often regarded as reference data [ <a href=\"#ref-11\">Friend D.G., 1989</a>].; <em>GT</em></td></tr>\n<tr class=\"cal\"><td class=\"right-nowrap\">33.51</td><td class=\"right-nowrap\">200.</td></tr>\n<tr class=\"cal\"><td class=\"right-nowrap\">35.69</td><td class=\"right-nowrap\">298.15</td></tr>\n<tr class=\"cal\"><td class=\"right-nowrap\">35.76</td><td class=\"right-nowrap\">300.</td></tr>\n<tr class=\"cal\"><td class=\"right-nowrap\">40.63</td><td class=\"right-nowrap\">400.</td></tr>\n<tr class=\"cal\"><td class=\"right-nowrap\">46.63</td><td class=\"right-nowrap\">500.</td></tr>\n<tr class=\"cal\"><td class=\"right-nowrap\">52.74</td><td class=\"right-nowrap\">600.</td></tr>\n<tr class=\"cal\"><td class=\"right-nowrap\">58.60</td><td class=\"right-nowrap\">700.</td></tr>\n<tr class=\"cal\"><td class=\"right-nowrap\">64.08</td><td class=\"right-nowrap\">800.</td></tr>\n<tr class=\"cal\"><td class=\"right-nowrap\">69.14</td><td class=\"right-nowrap\">900.</td></tr>\n<tr class=\"cal\"><td class=\"right-nowrap\">73.75</td><td class=\"right-nowrap\">1000.</td></tr>\n<tr class=\"cal\"><td class=\"right-nowrap\">77.92</td><td class=\"right-nowrap\">1100.</td></tr>\n<tr class=\"cal\"><td class=\"right-nowrap\">81.68</td><td class=\"right-nowrap\">1200.</td></tr>\n<tr class=\"cal\"><td class=\"right-nowrap\">85.07</td><td class=\"right-nowrap\">1300.</td></tr>\n<tr class=\"cal\"><td class=\"right-nowrap\">88.11</td><td class=\"right-nowrap\">1400.</td></tr>\n<tr class=\"cal\"><td class=\"right-nowrap\">90.86</td><td class=\"right-nowrap\">1500.</td></tr>\n<tr class=\"cal\"><td class=\"right-nowrap\">93.33</td><td class=\"right-nowrap\">1600.</td></tr>\n<tr class=\"cal\"><td class=\"right-nowrap\">95.58</td><td class=\"right-nowrap\">1700.</td></tr>\n<tr class=\"cal\"><td class=\"right-nowrap\">97.63</td><td class=\"right-nowrap\">1800.</td></tr>\n<tr class=\"cal\"><td class=\"right-nowrap\">99.51</td><td class=\"right-nowrap\">1900.</td></tr>\n<tr class=\"cal\"><td class=\"right-nowrap\">101.24</td><td class=\"right-nowrap\">2000.</td></tr>\n<tr class=\"cal\"><td class=\"right-nowrap\">102.83</td><td class=\"right-nowrap\">2100.</td></tr>\n<tr class=\"cal\"><td class=\"right-nowrap\">104.31</td><td class=\"right-nowrap\">2200.</td></tr>\n<tr class=\"cal\"><td class=\"right-nowrap\">105.70</td><td class=\"right-nowrap\">2300.</td></tr>\n<tr class=\"cal\"><td class=\"right-nowrap\">107.00</td><td class=\"right-nowrap\">2400.</td></tr>\n<tr class=\"cal\"><td class=\"right-nowrap\">108.23</td><td class=\"right-nowrap\">2500.</td></tr>\n<tr class=\"cal\"><td class=\"right-nowrap\">109.39</td><td class=\"right-nowrap\">2600.</td></tr>\n<tr class=\"cal\"><td class=\"right-nowrap\">110.50</td><td class=\"right-nowrap\">2700.</td></tr>\n<tr class=\"cal\"><td class=\"right-nowrap\">111.56</td><td class=\"right-nowrap\">2800.</td></tr>\n<tr class=\"cal\"><td class=\"right-nowrap\">112.57</td><td class=\"right-nowrap\">2900.</td></tr>\n<tr class=\"cal\"><td class=\"right-nowrap\">113.55</td><td class=\"right-nowrap\">3000.</td></tr>\n</table>\n\n<h3>Gas Phase Heat Capacity (Shomate Equation)</h3>\n<p>\nC<sub>p</sub>&deg; = A + B*t + C*t<sup>2</sup> + D*t<sup>3</sup> +\n E/t<sup>2</sup><br />\nH&deg; &#8722; H&deg;<sub>298.15</sub>= A*t + B*t<sup>2</sup>/2 +\n C*t<sup>3</sup>/3 + D*t<sup>4</sup>/4 &#8722; E/t + F &#8722; H<br />\nS&deg; = A*ln(t) + B*t + C*t<sup>2</sup>/2 + D*t<sup>3</sup>/3 &#8722;\n E/(2*t<sup>2</sup>) + G<br />\n&nbsp; &nbsp; C<sub>p</sub> = heat capacity (J/mol*K)<br />\n&nbsp; &nbsp; H&deg; = standard enthalpy (kJ/mol)<br />\n&nbsp; &nbsp; S&deg; = standard entropy (J/mol*K)<br />\n&nbsp; &nbsp; t = temperature (K) / 1000.<br />\n</p>\n<p>\n<a href=\"/cgi/cbook.cgi?ID=C74828&amp;Units=SI&amp;Mask=1&amp;Type=JANAFG&amp;Plot=on#JANAFG\">View plot</a>\nRequires a JavaScript / HTML 5 canvas capable browser.\n</p>\n<p>\n<a href=\"/cgi/cbook.cgi?ID=C74828&amp;Units=SI&amp;Mask=1&amp;Type=JANAFG&amp;Table=on#JANAFG\">View table</a>.\n</p>\n<table class=\"data\" aria-label=\"Gas Phase Heat Capacity (Shomate Equation)\" style=\"width: 50.00%;\">\n<colgroup>\n<col span=\"3\" style=\"width: 33.33%;\" />\n</colgroup>\n<tr><th scope=\"row\" style=\"text-align: left;\">Temperature (K)</th>\n<td class=\"exp right-nowrap\">298. to 1300.</td><td class=\"exp right-nowrap\">1300. to 6000.</td></tr>\n<tr><th scope=\"row\" style=\"text-align: left;\">A</th>\n<td class=\"exp right-nowrap\">-0.703029</td><td class=\"exp right-nowrap\">85.81217</td></tr>\n<tr><th scope=\"row\" style=\"text-align: left;\">B</th>\n<td class=\"exp right-nowrap\">108.4773</td><td class=\"exp right-nowrap\">11.26467</td></tr>\n<tr><th scope=\"row\" style=\"text-align: left;\">C</th>\n<td class=\"exp right-nowrap\">-42.52157</td><td class=\"exp right-nowrap\">-2.114146</td></tr>\n<tr><th scope=\"row\" style=\"text-align: left;\">D</th>\n<td class=\"exp right-nowrap\">5.862788</td><td class=\"exp right-nowrap\">0.138190</td></tr>\n<tr><th scope=\"row\" style=\"text-align: left;\">E</th>\n<td class=\"exp right-nowrap\">0.678565</td><td class=\"exp right-nowrap\">-26.42221</td></tr>\n<tr><th scope=\"row\" style=\"text-align: left;\">F</th>\n<td class=\"exp right-nowrap\">-76.84376</td><td class=\"exp right-nowrap\">-153.5327</td></tr>\n<tr><th scope=\"row\" style=\"text-align: left;\">G</th>\n<td class=\"exp right-nowrap\">158.7163</td><td class=\"exp right-nowrap\">224.4143</td></tr>\n<tr><th scope=\"row\" style=\"text-align: left;\">H</th>\n<td class=\"exp right-nowrap\">-74.87310</td><td class=\"exp right-nowrap\">-74.87310</td></tr>\n<tr><th scope=\"row\" style=\"text-align: left;\">Reference</th><td class=\"exp right\"><a href=\"#ref-1\">Chase, 1998</a></td><td class=\"exp right\"><a href=\"#ref-1\">Chase, 1998</a></td></tr>\n<tr><th scope=\"row\" style=\"text-align: left;\">Comment</th>\n<td class=\"exp left\">Data last reviewed in March, 1961</td>\n<td class=\"exp left\">Data last reviewed in March, 1961</td>\n</tr>\n</table>\n\n<hr />\n\n<h2 id=\"Refs\">References</h2>\n<p class=\"section-head\"><strong>Go To:</strong> <a href=\"#Top\">Top</a>, <a href=\"#Thermo-Gas\">Gas phase thermochemistry data</a>, <a href=\"#Notes\">Notes</a></p>\n<p class=\"section-head\"><strong>\nData compilation <a href=\"#copyright\">copyright</a>\nby the U.S. Secretary of Commerce on behalf of the U.S.A.\nAll rights reserved.\n</strong></p>\n<p>\n<span id=\"ref-1\"><strong>Chase, 1998</strong></span><br />\n<span class=\"Z3988\" title=\"ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.au=Chase%2C+M.W.%2C+Jr.&amp;rft.atitle=NIST-JANAF+Themochemical+Tables%2C+Fourth+Edition&amp;rft.date=1998&amp;rft.pages=1-1951&amp;rft.stitle=J.+Phys.+Chem.+Ref.+Data%2C+Monograph+9&amp;rft.volume=\"></span>\n<a href=\"/cgi/cbook.cgi?Author=Chase%2C+M.W.%2C+Jr.&amp;Units=SI&amp;Mask=1\">Chase, M.W., Jr.</a>,\n<em>NIST-JANAF Themochemical Tables, Fourth Edition</em>,\n<strong>J. Phys. Chem. Ref. Data, Monograph 9</strong>, 1998, 1-1951. [<a href=\"/cgi/cbook.cgi?Source=1998CHA1-1951&amp;Units=SI&amp;Mask=1\" title=\"Find all species with data from this source\">all data</a>]\n</p><p>\n<span id=\"ref-2\"><strong>Manion, 2002</strong></span><br />\n<span class=\"Z3988\" title=\"ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.au=Manion%2C+J.A.&amp;rft_id=info%3Adoi%2F10.1063%2F1.1420703&amp;rft.atitle=Evaluated+Enthalpies+of+Formation+of+the+Stable+Closed+Shell+C1+and+C2+Chlorinated+Hydrocarbons&amp;rft.date=2002&amp;rft.pages=123-172&amp;rft.stitle=J.+Phys.+Chem.+Ref.+Data&amp;rft.volume=31&amp;rft.issue=1\"></span>\n<a href=\"/cgi/cbook.cgi?Author=Manion%2C+J.A.&amp;Units=SI&amp;Mask=1\">Manion, J.A.</a>,\n<em>Evaluated Enthalpies of Formation of the Stable Closed Shell C1 and C2 Chlorinated Hydrocarbons</em>,\n<strong>J. Phys. Chem. Ref. Data</strong>, 2002, 31, 1, 123-172, <a title=\"The International DOI Foundation's resolver link for 10.1063/1.1420703\"\n href=\"https://dx.doi.org/10.1063/1.1420703\">https://doi.org/10.1063/1.1420703</a>\n. [<a href=\"/cgi/cbook.cgi?Source=2002MAN123-172&amp;Units=SI&amp;Mask=1\" title=\"Find all species with data from this source\">all data</a>]\n</p><p>\n<span id=\"ref-3\"><strong>Gurvich, Veyts, et al., 1991</strong></span><br />\n<span class=\"Z3988\" title=\"ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.date=1991&amp;rft.btitle=Thermodynamic+Properties+of+Individual+Substances%2C+4th+edition%2C+Volume+2&amp;rft.pub=Hemisphere&amp;rft.place=New+York\"></span>\n<strong>Thermodynamic Properties of Individual Substances, 4th edition, Volume 2</strong>, Gurvich, L.V